rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    // Only the authenticated user can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Bookings ───────────────────────────────────────────────────────────
    // Anyone can create a booking; only the owner can read theirs
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if request.auth != null &&
                    (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ── Contact enquiries ──────────────────────────────────────────────────
    // Public write (no auth needed); admins can read
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ── Newsletter subscribers ─────────────────────────────────────────────
    // Public write; admins can read
    match /subscribers/{subId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
